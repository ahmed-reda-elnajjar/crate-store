# Photorealistic try-on (fit room → "03 Real try-on"). Copy to .env.local and fill in.
# meta | fashn | replicate | mock   (mock = no key, returns the photo unchanged, for testing the UI)
TRYON_PROVIDER=
# Meta Model API key (dev.meta.ai) for TRYON_PROVIDER=meta
MODEL_API_KEY=
# optional output size for meta, e.g. 768x1024
META_IMAGE_SIZE=
FASHN_API_KEY=
REPLICATE_API_TOKEN=
# Looks each visitor can generate per day
TRYON_DAILY_LIMIT=20
